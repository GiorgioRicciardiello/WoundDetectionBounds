\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Wound healing dynamics across experimental conditions.} \textbf  {(A)} Mean wound closure speed (pixels/h) at $t = 20$~h, computed as the rate of wound edge displacement. \textbf  {(B)} Mean wound closure distance (pixels) at $t = 20$~h, representing cumulative inward displacement of the wound boundary from $t = 0$. \textbf  {(C)} Time-series of wound edge displacement over the full observation period. Error bars represent 95\% confidence intervals. Statistical comparisons were performed using Welch's $t$-test with Bonferroni correction. Sample sizes: Line~1~--~Alk5i: $n = 10$; Line~1~--~DMSO: $n = 8$; Line~1~--~Media: $n = 15$; Line~2~--~Alk5i: $n = 5$; Line~2~--~DMSO: $n = 15$; Line~2~--~Media: $n = 6$.}}{16}{figure.caption.11}\protected@file@percent }
\newlabel{fig:fig2}{{3}{16}{\textbf {Wound healing dynamics across experimental conditions.} \textbf {(A)} Mean wound closure speed (pixels/h) at $t = 20$~h, computed as the rate of wound edge displacement. \textbf {(B)} Mean wound closure distance (pixels) at $t = 20$~h, representing cumulative inward displacement of the wound boundary from $t = 0$. \textbf {(C)} Time-series of wound edge displacement over the full observation period. Error bars represent 95\% confidence intervals. Statistical comparisons were performed using Welch's $t$-test with Bonferroni correction. Sample sizes: Line~1~--~Alk5i: $n = 10$; Line~1~--~DMSO: $n = 8$; Line~1~--~Media: $n = 15$; Line~2~--~Alk5i: $n = 5$; Line~2~--~DMSO: $n = 15$; Line~2~--~Media: $n = 6$}{figure.caption.11}{}}
