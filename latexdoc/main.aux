\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Automated wound boundary detection and model quality metrics.} \textbf  {(A--C)} Representative phase-contrast images of a wound healing assay at three timepoints ($t = 0$, mid, and $t = 20$~h) with computationally detected wound boundaries overlaid as semi-transparent filled regions. Earlier timepoints are shown as faint dashed outlines; the current timepoint as solid fill. Images were acquired at 1.24~\textmu m/px. \textbf  {(D)} Normalized wound area over time, expressed as a fraction of the $t = 0$ wound area. Error bands represent 95\% confidence intervals. Sample sizes per group are provided in the legend. (Figure~\ref {fig:fig1} illustrates a single representative cell line/condition subset; the full dataset is shown in Figure~\ref {fig:fig2}.)}}{13}{figure.caption.19}\protected@file@percent }
\newlabel{fig:fig1}{{3}{13}{\textbf {Automated wound boundary detection and model quality metrics.} \textbf {(A--C)} Representative phase-contrast images of a wound healing assay at three timepoints ($t = 0$, mid, and $t = 20$~h) with computationally detected wound boundaries overlaid as semi-transparent filled regions. Earlier timepoints are shown as faint dashed outlines; the current timepoint as solid fill. Images were acquired at 1.24~\textmu m/px. \textbf {(D)} Normalized wound area over time, expressed as a fraction of the $t = 0$ wound area. Error bands represent 95\% confidence intervals. Sample sizes per group are provided in the legend. (Figure~\ref {fig:fig1} illustrates a single representative cell line/condition subset; the full dataset is shown in Figure~\ref {fig:fig2}.)}{figure.caption.19}{}}
