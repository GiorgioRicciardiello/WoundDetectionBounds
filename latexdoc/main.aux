\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Automated wound boundary detection and model quality metrics.} \textbf  {(A--C)} Representative phase-contrast images of a wound healing assay at three timepoints ($t = 0$, mid, and $t = 20$~h) with computationally detected wound boundaries overlaid as semi-transparent filled regions. Earlier timepoints are shown as faint dashed outlines; the current timepoint as solid fill. Images were acquired at 1.24~\textmu m/px. \textbf  {(D)} Normalised wound area over time, expressed as a fraction of the $t = 0$ wound area. Error bands represent 95\% confidence intervals. Sample sizes per group are provided in the legend. (Figure~\ref {fig:fig1} corresponds to the analysis of the ALK5i exposure, one cell line subset; full dataset is shown in Figure~\ref {fig:fig2}.)}}{15}{figure.caption.8}\protected@file@percent }
\newlabel{fig:fig1}{{2}{15}{\textbf {Automated wound boundary detection and model quality metrics.} \textbf {(A--C)} Representative phase-contrast images of a wound healing assay at three timepoints ($t = 0$, mid, and $t = 20$~h) with computationally detected wound boundaries overlaid as semi-transparent filled regions. Earlier timepoints are shown as faint dashed outlines; the current timepoint as solid fill. Images were acquired at 1.24~\textmu m/px. \textbf {(D)} Normalised wound area over time, expressed as a fraction of the $t = 0$ wound area. Error bands represent 95\% confidence intervals. Sample sizes per group are provided in the legend. (Figure~\ref {fig:fig1} corresponds to the analysis of the ALK5i exposure, one cell line subset; full dataset is shown in Figure~\ref {fig:fig2}.)}{figure.caption.8}{}}
